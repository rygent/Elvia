{
  "name": "@elvia/bot",
  "version": "7.0.0-beta",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsdown",
    "start": "node --no-warnings ./dist/index.js",
    "start:shard": "node --no-warnings ./dist/shard.js",
    "lint": "eslint \"src/**/*.ts\" --format=pretty",
    "lint:fix": "eslint \"src/**/*.ts\" --fix --format=pretty",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "register": "tsx --no-warnings ./scripts/register.ts"
  },
  "license": "GPL-3.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rygent/Elvia.git",
    "directory": "apps/bot"
  },
  "dependencies": {
    "@elvia/core": "workspace:^",
    "@elvia/database": "workspace:^",
    "@elvia/logger": "workspace:^",
    "@elvia/utils": "workspace:^",
    "@iamtraction/google-translate": "^3.0.0",
    "@rygent/anilist": "^1.5.0",
    "@sapphire/discord-utilities": "^4.0.0",
    "@sapphire/time-utilities": "^1.7.14",
    "@sapphire/type": "^2.6.0",
    "@sapphire/utilities": "^3.18.2",
    "colorette": "^2.0.20",
    "discord-api-types": "^0.38.54",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "globby": "^16.2.4",
    "jiti": "^2.7.0",
    "moment": "^2.30.1",
    "nanoid": "^6.0.1",
    "systeminformation": "^5.33.5",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "eslint-formatter-pretty": "^7.1.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "bufferutil": "^4.1.0"
  },
  "packageManager": "pnpm@11.22.0"
}
